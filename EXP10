matrix = [
    ['M', 'F', 'H', 'I', 'K'],
    ['U', 'N', 'O', 'P', 'Q'],
    ['Z', 'V', 'W', 'X', 'Y'],
    ['E', 'L', 'A', 'R', 'G'],
    ['D', 'S', 'T', 'B', 'C']
]


def find(ch):
    if ch == 'J':
        ch = 'I'

    for i in range(5):
        for j in range(5):
            if matrix[i][j] == ch:
                return i, j


def encrypt(text):
    text = ''.join(c for c in text.upper() if c.isalpha())
    text = text.replace('J', 'I')

    pairs = []
    i = 0

    while i < len(text):
        a = text[i]

        if i + 1 >= len(text):
            b = 'X'
            i += 1
        elif text[i] == text[i+1]:
            b = 'X'
            i += 1
        else:
            b = text[i+1]
            i += 2

        pairs.append((a, b))

    result = ""

    for a, b in pairs:
        r1, c1 = find(a)
        r2, c2 = find(b)

        if r1 == r2:
            result += matrix[r1][(c1+1)%5]
            result += matrix[r2][(c2+1)%5]

        elif c1 == c2:
            result += matrix[(r1+1)%5][c1]
            result += matrix[(r2+1)%5][c2]

        else:
            result += matrix[r1][c2]
            result += matrix[r2][c1]

    return result


message = input("Enter message: ")
print("Encrypted text:", encrypt(message))
