import math

text = input("Enter ciphertext: ").upper()
alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"

for a in range(1, 26):
    if math.gcd(a, 26) == 1:

        for i in range(26):
            if (a * i) % 26 == 1:
                inverse = i
                break

        for b in range(26):
            result = ""

            for ch in text:
                if ch in alphabet:
                    c = alphabet.index(ch)
                    p = (inverse * (c - b)) % 26
                    result += alphabet[p]
                else:
                    result += ch

            print("a =", a, "b =", b, ":", result)
